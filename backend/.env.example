# PostgreSQL — Hetzner (prod) o Docker local (dev)
DATABASE_URL=postgresql+asyncpg://servilla:TU_PASSWORD@localhost:5432/servilla_erp

# bases_web (Servilla/iMile) — solo lectura
BASES_WEB_URL=mysql+pymysql://usuario_solo_lectura:CLAVE@HOST_BASES_WEB:3306/bases_web
# Opcional: TLS hacia MariaDB → agregar ?ssl_ca=/ruta/ca.pem (o ?ssl=1). Sin URL completa la integración queda deshabilitada.

# Imágenes de guía del servidor legado (proxy autenticado del ERP). Vacío = deshabilitado.
IMAGENES_LEGADO_URL=https://HOST_IMAGENES/guias
# Opcional: certificado para verificar TLS del servidor de imágenes
IMAGENES_LEGADO_CA=

# JWT
JWT_SECRET=cambia-esto-en-produccion-minimo-32-caracteres
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRE_MINUTES=60
JWT_REFRESH_EXPIRE_DAYS=30

# CORS
ALLOWED_ORIGINS=http://localhost:5173,https://servilla-erp.vercel.app

# Entorno
ENVIRONMENT=development

#Imile
IMILE_USER=
IMILE_PASS=